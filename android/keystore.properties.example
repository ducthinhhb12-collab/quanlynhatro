# ==============================================================================
# Keystore Properties Example (An Gia Smart Home 3D)
# Hướng dẫn: Sao chép tệp này thành 'keystore.properties' trong thư mục 'android/'
#            Điền thông tin khóa của bạn để ký số khi build bản Release cục bộ.
# LƯU Ý: Tệp 'keystore.properties' đã được chặn bởi .gitignore, KHÔNG ĐẨY LÊN GIT.
# ==============================================================================

KEYSTORE_FILE=angia-release-key.jks
KEYSTORE_PASSWORD=AngiaSmartHome2026!Secured
KEY_ALIAS=angia-key-alias
KEY_PASSWORD=AngiaSmartHome2026!Secured
