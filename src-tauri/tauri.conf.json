{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "An Gia Smart Home 3D",
  "version": "1.0.0",
  "identifier": "com.angia.smarthome3d",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "An Gia Smart Home 3D",
        "width": 1280,
        "height": 840,
        "minWidth": 375,
        "minHeight": 667,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "developmentTeam": ""
    }
  }
}
